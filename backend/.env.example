APP_NAME="NetOps Command Center"
ENVIRONMENT=local
DATABASE_URL=sqlite:///./data/netops.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCHEDULER_ENABLED=false
HEALTH_CHECK_INTERVAL_SECONDS=300
PING_TIMEOUT_SECONDS=1.5
TCP_TIMEOUT_SECONDS=2.0
HTTP_TIMEOUT_SECONDS=4.0
SSH_TIMEOUT_SECONDS=3.0
AUTOMATION_SSH_TIMEOUT_SECONDS=12
AUTOMATION_DEFAULT_SSH_USER=root
AUTOMATION_REQUESTED_BY=netops-local
AUTOMATION_HOST_CONFIG_PATH=./config/automation_hosts.local.json
AUTO_TRIAGE_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
